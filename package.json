{
  "name": "dsh-overnight-guard",
  "version": "1.0.0",
  "description": "Overnight guard plugin for DeepSeek Harness — auto-recovers stream stalls and provider failures so unattended jobs survive the night.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DashZero/overnight-guard-dsh-plugin.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "overnight-guard"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
